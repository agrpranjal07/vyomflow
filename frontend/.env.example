# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_BACKEND_API_URL=

# Site URL for open graph and social metadata. Optional — defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Sidebar "API / MCP" link. Optional — falls back to the live docs site
# (https://docs.vyomflow.co.in) if unset.
NEXT_PUBLIC_API_DOCS_URL=
