# Copy to .env.local and fill in real values. Never commit .env.local.

DATABASE_URL=
# Separate database used only by integration tests (never the dev DB).
TEST_DATABASE_URL=
# Scratch database Prisma uses to compute migration diffs non-interactively
# (`prisma migrate diff`) — never holds real data, safe to drop/recreate.
SHADOW_DATABASE_URL=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend origin allowed to call the private `/api/v1/*` surface
# cross-origin (CORS allowlist for the cookie/session-token flow only —
# the public `/api/public/v1/*` + `/api/mcp` surface is bearer-only and
# always allows `*`, independent of this var).
# Local: http://localhost:3001 — Preview: the deployment's preview URL —
# Production: https://www.vyomflow.co.in
FRONTEND_ORIGIN=http://localhost:3001

# This API's own public base URL (OpenAPI `servers`, public-surface links).
# Required in production — module load throws if unset there.
# Local: http://localhost:3000 — Preview: the deployment's preview URL —
# Production: https://api.vyomflow.co.in
PUBLIC_API_BASE_URL=http://localhost:3000

OPENROUTER_API_KEY=
# Optional override; defaults to https://openrouter.ai/api/v1 in code.
OPENROUTER_BASE_URL=

# Required — Cloudflare Workers AI (generate_image tool,
# @cf/black-forest-labs/flux-2-klein-4b). Never expose these to client-side
# code, model prompts, logs, or persisted message content.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Trigger.dev API key. Local/Preview: a dev key from the project's Trigger.dev
# dashboard. Production: the project's production key.
TRIGGER_SECRET_KEY=
# Non-secret project identifier, read by trigger.config.ts.
TRIGGER_PROJECT_REF=

# Both read lazily via process.env, backend-only — never committed with real values.
TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=
# Optional — defaults to the value already in use if unset.
TRANSLOADIT_UPLOAD_TEMPLATE_ID=6dcc633bc81c4ea49bfcb5ca0e9e462a
# Optional — defaults to the value already in use if unset.
TRANSLOADIT_INGEST_TEMPLATE_ID=050c3ae0e2cf423a9cf7dc7f5d8eb808
# Optional — defaults to the value already in use if unset.
TRANSLOADIT_GENERATED_UPLOAD_TEMPLATE_ID=62b321e9c3a44faeb195263cf9cbc0f2
